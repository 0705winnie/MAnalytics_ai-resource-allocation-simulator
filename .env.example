# ──────────────────────────────────────────────
#  AI Resource Allocation Simulator — .env
#  Copy this file to .env and fill in your values.
#  The .env file is gitignored — never commit it.
# ──────────────────────────────────────────────

# ── PostgreSQL (local development placeholders) ───────────────────────────────
POSTGRES_DB=resource_allocation
POSTGRES_USER=resource_app
POSTGRES_PASSWORD=resource_dev_only_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://resource_app:resource_dev_only_change_me@localhost:5432/resource_allocation
TEST_DATABASE_URL=postgresql+psycopg://resource_app:resource_dev_only_change_me@localhost:5432/resource_allocation_test

# ── Local development instructor seed (never commit real credentials) ────────
DEV_INSTRUCTOR_USERNAME=
DEV_INSTRUCTOR_PASSWORD=

# Which LLM provider to use.
# Set to "mock" to run locally without any API key.
# Set to "azure" to use Azure OpenAI (requires the four vars below).
LLM_PROVIDER=mock

# ── Azure OpenAI credentials (only needed when LLM_PROVIDER=azure) ──────────
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Optional ─────────────────────────────────────────────────────────────────
# Override CORS allowed origins for deployment (comma-separated)
# CORS_ALLOW_ORIGINS=https://your-deployed-dashboard.example.com
