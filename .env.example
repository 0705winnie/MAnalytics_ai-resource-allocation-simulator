# ──────────────────────────────────────────────
#  AI Resource Allocation Simulator — .env
#  Copy this file to .env and fill in your values.
#  The .env file is gitignored — never commit it.
# ──────────────────────────────────────────────

# Which LLM provider to use.
# Set to "mock" to run locally without any API key.
# Set to "azure" to use Azure OpenAI (requires the four vars below).
LLM_PROVIDER=mock

# ── Azure OpenAI credentials (only needed when LLM_PROVIDER=azure) ──────────
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Optional ─────────────────────────────────────────────────────────────────
# Override CORS allowed origins for deployment (comma-separated)
# CORS_ALLOW_ORIGINS=https://your-deployed-dashboard.example.com
